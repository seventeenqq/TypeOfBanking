<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CurrencyConverter.Core.ViewModels;assembly=CurrencyConverter.Core"
             x:Class="CurrencyConverter.App.MainPage"
             x:DataType="vm:ConverterViewModel"
             BackgroundColor="#F5F7FA">
    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="16" MaximumWidthRequest="600">
            <Label Text="Конвертер валют" FontSize="28" FontAttributes="Bold" TextColor="#152238" />
            <Label Text="Курсы Центрального банка России" FontSize="14" TextColor="#536174" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Label Text="Дата" VerticalOptions="Center" />
                <DatePicker Grid.Column="1" Date="{Binding SelectedDate, Mode=TwoWay}"
                            MaximumDate="{Binding MaximumDate}" IsEnabled="{Binding CanEdit}" Format="dd.MM.yyyy" />
            </Grid>
            <Label Text="{Binding RateHint}" FontSize="14" TextColor="#315C8C" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Border BackgroundColor="White" Stroke="#DCE3EC" Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8" IsEnabled="{Binding CanConvert}">
                    <Label Text="Из валюты" FontSize="13" TextColor="#536174" />
                    <Picker Title="Выберите валюту" ItemsSource="{Binding Currencies}"
                            ItemDisplayBinding="{Binding DisplayName}" x:DataType="{x:Null}"
                            SelectedItem="{Binding FromCurrency, Mode=TwoWay}" />
                    <Entry Text="{Binding FromAmount, Mode=TwoWay}" Keyboard="Numeric"
                           Placeholder="Введите сумму" FontSize="24" MaxLength="32" />
                </VerticalStackLayout>
            </Border>
            <Label Text="↕" HorizontalOptions="Center" FontSize="26" TextColor="#315C8C" />
            <Border BackgroundColor="White" Stroke="#DCE3EC" Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8" IsEnabled="{Binding CanConvert}">
                    <Label Text="В валюту" FontSize="13" TextColor="#536174" />
                    <Picker Title="Выберите валюту" ItemsSource="{Binding Currencies}"
                            ItemDisplayBinding="{Binding DisplayName}" x:DataType="{x:Null}"
                            SelectedItem="{Binding ToCurrency, Mode=TwoWay}" />
                    <Entry Text="{Binding ToAmount, Mode=TwoWay}" Keyboard="Numeric"
                           Placeholder="Введите сумму" FontSize="24" MaxLength="32" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding InputError}" TextColor="#B42318" FontSize="13" />
            <Label Text="{Binding ErrorMessage}" TextColor="#B42318" FontSize="13" />
            <Button Text="Обновить курсы" Clicked="OnRefreshClicked" IsEnabled="{Binding CanEdit}" BackgroundColor="#315C8C" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
